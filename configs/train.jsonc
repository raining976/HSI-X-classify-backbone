{
  "experiment_name": "train_experiment_hsi_x",
  "dataset_type": [0],
  // "model_name": ["SSFuseMamba","FusAtNet","ExViT","MICF_Net", "CNN","FDNet","S2ENet","AsyFFNet","HCTNet","MACN"],
  "model_name": ["ACFNet"],
  "cuda_device": "cuda:0",
  "learning_rate": 0.0001,
  "optimizer_name": "adamw",
  "weight_decay": 0.01,
  "label_smoothing": 0.1,
  "warmup_epochs": 3,
  "min_learning_rate": 1e-6,
  "epochs": 100,
  "batch_size": 128,
  "num_workers": 0,
  "random_seed": 6,
  "channels": 40 ,
  "window_size": 11,
  "acfnet_attention_mode": "softmax",
  "acfnet_num_interaction_layers": 2,
  "acfnet_fusion_scan": "hilbert3d",
  "acfnet_d_state": 16,
  "acfnet_use_concentration": true,
  "stage_depths": [1,1],
  "enable_training": true,
  "enable_testing": true,
  "enable_visualization": false,
  "enable_tsne": false,
  "enable_erf": false,
  "enable_early_stopping": true,
  "early_stopping_patience": 20,
  "early_stopping_min_delta": 0.0001,
  "enable_email_notification": true,
  "email_recipient_override": ""
}
